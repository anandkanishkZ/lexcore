PORT=8089
MONGODB_URL=mongodb://localhost:27017/lexcore-db
SECRET_KEY=your_secret_key_here

# Comma-separated list of origins allowed to call the API from a browser.
CORS_ORIGIN=http://localhost:3000

# SMTP for outgoing email (case request notifications). If unset, emails are
# logged to the console instead of sent — safe for local dev without a real
# mail account.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Lexcore <no-reply@lexcore.local>

# DeepSeek API key for the AI case/document search feature. If unset, the
# feature responds with a graceful "not configured" error instead of
# failing startup — safe for local dev without a key.
DEEPSEEK_API_KEY=

# Symmetric key used to encrypt the eSewa payment gateway secret at rest
# (admin sets the gateway credentials from Firm Settings; the secret itself
# is never stored in plaintext). Required only once an admin actually saves
# an eSewa secret — generate with `openssl rand -hex 32`.
ENCRYPTION_KEY=
