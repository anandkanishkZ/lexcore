PORT=8089
MONGODB_URL=mongodb://localhost:27017/lexcore-db
SECRET_KEY=your_secret_key_here

# Comma-separated list of origins allowed to call the API from a browser.
CORS_ORIGIN=http://localhost:3000

# SMTP for outgoing email (case request notifications). If unset, emails are
# logged to the console instead of sent — safe for local dev without a real
# mail account.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Lexcore <no-reply@lexcore.local>

# DeepSeek API key for the AI case/document search feature. If unset, the
# feature responds with a graceful "not configured" error instead of
# failing startup — safe for local dev without a key.
DEEPSEEK_API_KEY=

# Symmetric key used to encrypt the eSewa payment gateway secret at rest
# (admin sets the gateway credentials from Firm Settings; the secret itself
# is never stored in plaintext). Required only once an admin actually saves
# an eSewa secret — generate with `openssl rand -hex 32`.
ENCRYPTION_KEY=

# Automated backups (npm run backup / npm run restore — see scripts/).
# BACKUP_SCHEDULE_CRON, if set, runs a full DB + uploads backup on that
# schedule from inside the running server process (standard cron syntax,
# e.g. "0 3 * * *" for 3am daily) — no OS-level cron/Task Scheduler setup
# needed. Leave unset to only ever back up manually via `npm run backup`.
BACKUP_SCHEDULE_CRON=
# How many timestamped backups to keep before the oldest are pruned.
BACKUP_RETENTION_COUNT=14

# Optional malware scanning for uploaded files (documents + chat
# attachments) via a running ClamAV daemon. If unset, uploads skip AV
# scanning entirely (file-signature/magic-byte verification against the
# declared type still always runs, regardless of this setting) — see
# utils/malware-scan.util.ts.
CLAMD_HOST=
CLAMD_PORT=3310

# Optional error tracking (Sentry). If unset, errors are only logged to
# the console, same as before this was added.
SENTRY_DSN=

# Optional push notifications (Firebase Cloud Messaging), for the mobile
# app. If unset — or if firebase-service-account.json isn't present at the
# repo root — push is skipped entirely; in-app + email notifications are
# unaffected either way. Download the key from Firebase Console > Project
# Settings > Service Accounts > Generate new private key, save it as
# firebase-service-account.json (git-ignored) or point this at wherever you
# saved it instead.
FIREBASE_SERVICE_ACCOUNT_PATH=
