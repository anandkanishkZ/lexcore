# Backend API origin. Falls back to http://localhost:8089 everywhere it's
# read if this is unset, so local dev works without a .env.local at all.
NEXT_PUBLIC_API_URL=http://localhost:8089

# Optional error tracking (Sentry) — see instrumentation.ts /
# instrumentation-client.ts. Both unset by default; errors are only logged
# to the console/terminal until these are supplied.
# NEXT_PUBLIC_ prefix is required for the client-side DSN to actually reach
# browser code — SENTRY_DSN (no prefix) is for the server-side one and is
# never exposed to the browser.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
